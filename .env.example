# MiroFish AM Simulator — environment template
# Copy to .env and edit. The pre-scripted scenarios run with no LLM keys;
# the variables below are reserved for an optional LLM enrichment hook
# (modeled on upstream MiroFish, which uses an OpenAI-SDK-compatible provider).

# Optional LLM (OpenAI-compatible)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

# Optional Zep memory (upstream MiroFish dependency)
ZEP_API_KEY=

# CORS — leave * for local dev; restrict in production
ALLOWED_ORIGINS=*
